# ─── قاعدة البيانات ────────────────────────────────────────────────
# التطوير المحلي (افتراضي): SQLite
DATABASE_URL="file:./db/custom.db"

# النشر السحابي (Vercel): PostgreSQL — مثل Neon المجاني
# 1) أنشئ قاعدة على https://neon.tech ثم انسخ «سلسلة الاتصال المباشرة»
#    (Direct connection — بدون كلمة pooler في المضيف)
# 2) أضفها في Vercel ← Project ← Settings ← Environment Variables باسم DATABASE_URL
# 3) لا حاجة لأي خطوة أخرى: أمر البناء ينشئ الجداول تلقائيًا
#    عبر prisma/schema.postgres.prisma (انظر scripts.build في package.json)
#
# DATABASE_URL="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/souq?sslmode=require"

# ─── ملاحظات ───────────────────────────────────────────────────────
# - مفاتيح مزود الذكاء الاصطناعي تُضبط في بيئة الاستضافة ولا تُكتب في الكود أبدًا.
#   (الوكيل يعمل محليًا؛ وفي الاستضافة السحابية يعرض حالة «غير متاح» بصدق إن لم
#   تتوفر خدمته — بقية أدوات المنصة لا تعتمد عليه).
# - أسعار السوق تُجلب لحظيًا من Yahoo Finance — لا تحتاج أي مفتاح API.
